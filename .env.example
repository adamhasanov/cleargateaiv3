# Copy to .env.local for local development. Never commit real values.

# --- Document extraction (server-side only) ---------------------------------
# Provider used by the AI extraction component: "gemini" (default) or "anthropic".
# If the chosen provider has no key, extraction is reported as "not configured"
# and no result is produced (nothing is simulated).
CLEARGATE_EXTRACTION_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only needed if CLEARGATE_EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-3.8-flash / claude-opus-5-5
CLEARGATE_EXTRACTION_MODEL=

# --- Landing page ------------------------------------------------------------
# Optional URL of a different looping, muted harbor video (MP4/WebM). If empty,
# the bundled Baku harbor clip at /media/hero-harbor.mp4 is used.
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- Demonstration support (MVP_SCOPE 9.5) -----------------------------------
# "true" shows a button that runs the rule engine on PREPARED sample values.
# The result is always labelled as a prepared sample, never as a live reading.
NEXT_PUBLIC_ENABLE_SAMPLE_DEMO=false

# --- AI Customs Advisor (server-side only) --------------------------------------
# Provider for the advisor chat: "gemini" or "anthropic". Default: same as extraction.
CLEARGATE_ADVISOR_PROVIDER=
# Optional model override. Defaults: gemini-3.6-flash (then Flash-Lite fallbacks) / claude-sonnet-5-5
CLEARGATE_ADVISOR_MODEL=

# --- Database --------------------------------------------------------------------
# Empty: an embedded PostgreSQL (PGlite) in ./.data/db — local development only.
# Production (e.g. Vercel): a hosted PostgreSQL connection string (Neon, Supabase, RDS, …).
# Migrations run automatically on first connection.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- App URL -------------------------------------------------------------------
# Public base URL used in e-mails and payment return links, e.g. https://cleargate.az
APP_BASE_URL=

# --- E-mail (password reset) ---------------------------------------------------------
# Resend (https://resend.com). Without these, development prints reset e-mails to the
# server console and production sends nothing (reset e-mails will not arrive).
RESEND_API_KEY=
MAIL_FROM=

# --- Payments: Epoint (epoint.az) ----------------------------------------------------
# Merchant keys from the Epoint merchant cabinet. Without them, pay buttons are disabled.
# Also set the result URL in the Epoint cabinet to https://<your-domain>/api/payments/epoint/callback
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
# Leave empty for production (https://epoint.az). For local testing with the TEST gateway
# (npm run epoint:sandbox): http://localhost:8181 with EPOINT_PUBLIC_KEY=i000000001 and
# EPOINT_PRIVATE_KEY=sandbox-private-key-change-me
EPOINT_BASE_URL=

# --- Prices (qəpik: 100 = 1.00 AZN) ---------------------------------------------------
# Starter = 3 AZN per document (CHECK_PRICE_MINOR); it has no monthly/annual subscription.
# Premium = plan code "professional"; VIP = plan code "business". An empty price cannot be bought.
CHECK_PRICE_MINOR=300
PLAN_PRICE_STARTER_MONTHLY=
PLAN_PRICE_STARTER_ANNUAL=
PLAN_PRICE_PROFESSIONAL_MONTHLY=6000
PLAN_PRICE_PROFESSIONAL_ANNUAL=30000
PLAN_PRICE_BUSINESS_MONTHLY=6000
PLAN_PRICE_BUSINESS_ANNUAL=60000

# --- Pre-AI masking: local OCR for scanned images -------------------------------------
# Tesseract language data (az, ru, en) is downloaded once from the tessdata CDN and cached.
# Optional: a local folder for the cache, or a self-hosted URL/folder to load the data from.
TESSDATA_CACHE_DIR=
TESSDATA_LANG_PATH=
